# DUST configuration. Copy to .env and fill in as needed.
# Environment variables map to settings fields (case-insensitive).

# Which adapter to use: mock | anthropic | openai | huggingface | ollama
LLM_PROVIDER=mock

# Optional: force a specific model id (provider default used if empty).
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# Provider credentials / endpoints (only the selected provider's are needed).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
HF_MODEL_ENDPOINT=
OLLAMA_BASE_URL=http://localhost:11434
